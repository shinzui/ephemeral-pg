FROM ephemeral-pg-plan3-probe
USER root
RUN apt-get update && apt-get install -y --no-install-recommends cabal-install libpq-dev zlib1g-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /project
COPY ephemeral-pg.cabal LICENSE README.md CHANGELOG.md /project/
COPY src /project/src
COPY test /project/test
RUN chown -R postgres:postgres /project
USER postgres
RUN cabal update || (sed -i 's|http://hackage.haskell.org/|https://hackage.haskell.org/|' /var/lib/postgresql/.config/cabal/config && cabal update)
RUN cabal build ephemeral-pg-test
CMD ["cabal", "test", "ephemeral-pg-test", "--test-show-details=direct"]
